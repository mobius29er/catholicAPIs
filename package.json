{
  "name": "catholic-apis",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A community-ranked directory of free and paid Catholic APIs.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply catholic-apis --local",
    "db:migrate:remote": "wrangler d1 migrations apply catholic-apis --remote",
    "db:reset:local": "rm -rf .wrangler/state/v3/d1 && npm run db:migrate:local",
    "seed:build": "node scripts/build-seed.mjs",
    "links:check": "node scripts/check-links.mjs",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "hono": "^4.9.10"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260811.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.42.0"
  }
}
