{
  // Tests run in Node, not in a Worker, and some of them read the migrations
  // off disk to check the app agrees with the schema. They therefore need
  // @types/node — which the Worker source must NOT have, or code that cannot
  // run at the edge would typecheck cleanly. Hence two configs.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["@cloudflare/workers-types", "node"]
  },
  "include": ["test/**/*.ts", "src/**/*.ts", "src/**/*.tsx"]
}
