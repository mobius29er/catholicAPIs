{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "catholic-apis",
  "main": "src/index.tsx",
  "compatibility_date": "2026-08-13",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },

  // Static files (CSS, JS, icons) are served straight from Cloudflare's edge.
  // `run_worker_first` is false so asset requests never touch the Worker; every
  // other path falls through to the Hono app in src/index.tsx.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },

  "d1_databases": [
    {
      "binding": "DB",
      // Still "catholic-apis" after the rename to FidesHunt, on purpose: D1
      // databases cannot be renamed, and recreating one to change a label would
      // mean migrating 237 listings and every vote cast against them for no
      // user-visible gain. The binding is what the code sees, and that is `DB`.
      "database_name": "catholic-apis",
      // Written by `npm run deploy:setup`; see scripts/deploy.mjs.
      "database_id": "6b3c70bd-3424-4627-bc20-a6cc449f2848",
      "migrations_dir": "migrations"
    }
  ],

  // The public address, declared here rather than clicked into the dashboard so
  // it is reviewable and survives a rebuild of the account. Cloudflare creates
  // and manages the DNS records for a custom_domain route.
  //
  // A hostname can belong to exactly one Worker. If a deploy fails here saying
  // the domain is already in use, something else is holding it — remove that
  // binding first rather than working around it.
  "routes": [
    { "pattern": "fideshunt.com", "custom_domain": true },
    { "pattern": "www.fideshunt.com", "custom_domain": true }
  ],

  // Uptime checks. Every six hours, offset off the hour so it does not land in
  // the same minute as everyone else's cron. Each run probes a batch of the
  // least-recently-checked listings; see src/health.ts.
  "triggers": {
    "crons": ["17 */6 * * *"]
  },

  "vars": {
    // Pinned now that fideshunt.com is attached and serving. Before that it was
    // deliberately unset, so the Worker described itself using whatever origin
    // the request arrived on — correct for a workers.dev preview, and better
    // than pointing search engines at a domain that was not answering yet.
    //
    // Pinned it must be, because `www.fideshunt.com` serves the same Worker.
    // Left unset, www would canonicalise to www and the apex to the apex, and
    // the two would split the ranking of every page between them.
    "SITE_URL": "https://fideshunt.com",
    "SITE_NAME": "FidesHunt"
  }

  // Secrets (set with `wrangler secret put <NAME>`), all optional:
  //   VOTE_SECRET      - HMAC key for signing anonymous voter cookies. Strongly recommended.
  //   ADMIN_TOKEN      - enables the /admin moderation queue when set.
  //   TURNSTILE_SITEKEY / TURNSTILE_SECRET - enables Turnstile on the submit form.
  //   (TURNSTILE_SITEKEY is public; it can also live in "vars" above.)
}
