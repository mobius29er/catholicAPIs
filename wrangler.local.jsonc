{
  "name": "fideshunt-local-preview",
  "main": "src/index.tsx",
  "compatibility_date": "2026-08-13",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {"directory": "./public", "binding": "ASSETS", "not_found_handling": "none"},
